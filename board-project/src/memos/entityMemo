@Entity entity 명시
@Getter 자동으로 getter 생성 ( lombok )
@Setter 자동으로 setter 생성 ( lombok )

@Id - 기본키(pk) 지정
@GeneratedValue(strategy = GenerationType.IDENTITY) - 번호 자동 증가
private Long id;

@Column(unique = true) - 중복 불가 컬럼

@ManyToOne  - N:1 관계 표시
@JoinColumn(name = "post_id", nullable = false ) - FK 컬럼 지정, 필수값

@OneToOne (1:1)
@OneToMany (1:N)
@ManyToOne (N:1)
@ManyToMany (M:N)

